# Test that the i386 OMF (Object Module Format) BFD backend correctly
# parses sections, symbols, and relocations from OMF object files.
#
# Test objects are generated by gentestomf.c (which lives under
# testsuite/ in the build directory) and linked with $(BFDLIB).

if ![is_remote host] {
    if {[which $OBJDUMP] == 0} then {
	perror "$OBJDUMP does not exist"
	return
    }
}

# Locate the gentestomf test helper.
global base_dir
set gentestomf "$base_dir/testsuite/gentestomf"
if ![file exists $gentestomf] {
    untested "OMF tests (gentestomf not built)"
    return
}

# Generate test objects in tmpdir.
set got [binutils_run $gentestomf "tmpdir"]
if { [regexp "done" $got] } {
    pass "OMF test object generation"
} else {
    fail "OMF test object generation"
    return
}

# -----------------------------------------------------------------------
#  basic.o — minimal valid OMF object
# -----------------------------------------------------------------------
set test "OMF basic: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/basic.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF basic: section _TEXT"
if { [regexp "_TEXT.*00000010.*CONTENTS, ALLOC, LOAD" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  modend_startaddr.o — MODEND with Start Address subfield
# -----------------------------------------------------------------------
set test "OMF modend startaddr: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/modend_startaddr.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF modend startaddr: start address field"
if { [regexp "start address" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  section_offsets.o — multiple LEDATA records at non-zero offsets
# -----------------------------------------------------------------------
set test "OMF sections: size from multiple LEDATA"
set got [binutils_run $OBJDUMP "-x tmpdir/section_offsets.o"]
if { [regexp "_TEXT.*00000040" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  symbols.o — EXTDEF and PUBDEF symbols
# -----------------------------------------------------------------------
set test "OMF symbols: PUBDEF"
set got [binutils_run $OBJDUMP "-x tmpdir/symbols.o"]
if { [regexp "public_var" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF symbols: EXTDEF"
if { [regexp "external_func" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  linsym.o — LINSYM record with line-number entries
# -----------------------------------------------------------------------
set test "OMF linsym: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/linsym.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  fixups_simple.o — simple F0+T0 relocation
# -----------------------------------------------------------------------
set test "OMF relocs: HAS_SYMS flag"
set got [binutils_run $OBJDUMP "-x tmpdir/fixups_simple.o"]
if { [regexp "HAS_SYMS" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs: RELOC flag"
if { [regexp "RELOC" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs: OFFPC16 entry"
if { [regexp "OFFPC16" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs: WRTSEG entry"
if { [regexp "WRTSEG" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  fixups_threads.o — THREAD-defined FRAME via thread slot
# -----------------------------------------------------------------------
set test "OMF relocs via threads: OFFPC16"
set got [binutils_run $OBJDUMP "-x tmpdir/fixups_threads.o"]
if { [regexp "OFFPC16" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  fixups_all.o — comprehensive relocations (F0-F5, T0-T7, threads)
# -----------------------------------------------------------------------
set test "OMF relocs all: sections"
set got [binutils_run $OBJDUMP "-x tmpdir/fixups_all.o"]
if { [regexp "_TEXT" $got] && [regexp "_DATA" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs all: GRPDEF frame (WRTSEG my_group)"
if { [regexp "WRTSEG.*my_group" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs all: EXTDEF target"
if { [regexp "external_func" $got] } {
    pass $test
} else {
    fail $test
}

# Check that 5 fixups produce the expected number of reloc lines.
set test "OMF relocs all: count"
set reloc_lines [regexp -all -inline {^\S+ \S+ \S+$} $got]
if { [llength $reloc_lines] == 10 } {
    pass $test
} else {
    fail "$test (got [llength $reloc_lines] lines)"
}

# -----------------------------------------------------------------------
#  Error cases — all must be rejected with "file format not recognized"
# -----------------------------------------------------------------------
foreach errfile {error_no_leidata error_undefined_thread error_bad_location error_f3_frame} {
    set test "OMF error: $errfile"
    set got [binutils_run $OBJDUMP "-x tmpdir/$errfile.o"]
    if { [regexp "file format not recognized" $got] } {
	pass $test
    } else {
	fail $test
    }
}

# Verify specific error messages.
set test "OMF error: FIXUP without LEIDATA"
set got [binutils_run $OBJDUMP "-x tmpdir/error_no_leidata.o"]
if { [regexp "FIXUP record without LEIDATA" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF error: undefined FRAME thread"
set got [binutils_run $OBJDUMP "-x tmpdir/error_undefined_thread.o"]
if { [regexp "undefined FRAME thread" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF error: bad location 14"
set got [binutils_run $OBJDUMP "-x tmpdir/error_bad_location.o"]
if { [regexp "unsupported location type 14" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF error: F3 explicit frame"
set got [binutils_run $OBJDUMP "-x tmpdir/error_f3_frame.o"]
if { [regexp "invalid explicit frame method F3" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  COMDEF tests
# -----------------------------------------------------------------------
set test "OMF comdef: NEAR symbol"
set got [binutils_run $OBJDUMP "-x tmpdir/comdef.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF comdef: HAS_SYMS flag"
if { [regexp "HAS_SYMS" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF comdef: NEAR symbol _var"
if { [regexp "_var" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF comdef: FAR symbol _var3"
if { [regexp "_var3" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF error: COMDEF bad data type"
set got [binutils_run $OBJDUMP "-x tmpdir/error_comdef_bad_type.o"]
if { [regexp "file format not recognized" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  comdat.o — COMDAT record with data
# -----------------------------------------------------------------------
set test "OMF comdat: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/comdat.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF comdat: section contents"
if { [regexp "_TEXT.*00000030" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  skipped_record.o — unrecognized/ignored record types skipped by length
# -----------------------------------------------------------------------
set test "OMF skipped record: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/skipped_record.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF skipped record: section contents"
if { [regexp "_TEXT.*00000010" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  lidata_simple.o — TIS Example 2: 10 dup('ALPHA','BETA') = 90 bytes
# -----------------------------------------------------------------------
set test "OMF lidata: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/lidata_simple.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF lidata: section size 90 bytes"
if { [regexp "_TEXT.*0000005a" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF lidata: HAS_CONTENTS flag"
if { [regexp "HAS_CONTENTS" $got] } {
    pass $test
} else {
    fail $test
}

# Verify by dumping contents; expect "ALPHABETA" repeated in the hex dump.
set test "OMF lidata: content ALPHABETA"
set got [binutils_run $OBJDUMP "-s tmpdir/lidata_simple.o"]
if { [regexp "ALPHABETA" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  lidata_nested.o — TIS Example 1 style nested blocks
# -----------------------------------------------------------------------
set test "OMF lidata nested: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/lidata_nested.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF lidata nested: section size 20 bytes"
if { [regexp "_TEXT.*00000014" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  lidata_32bit.o — LIDATA386 record
# -----------------------------------------------------------------------
set test "OMF lidata 32-bit: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/lidata_32bit.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF lidata 32-bit: content at offset 0x10"
set got [binutils_run $OBJDUMP "-s tmpdir/lidata_32bit.o"]
if { [regexp "deadbeef" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  Negative tests — all must be rejected
# -----------------------------------------------------------------------
foreach errfile {lidata_truncated lidata_zero_segidx lidata_overflow} {
    set test "OMF lidata error: $errfile"
    set got [binutils_run $OBJDUMP "-x tmpdir/$errfile.o"]
    if { [regexp "file format not recognized" $got] } {
	pass $test
    } else {
	fail $test
    }
}

