}

# -----------------------------------------------------------------------
#  alignment_6.o — 32-bit SEGDEF with alignment=6 (LTL) → paragraph
# -----------------------------------------------------------------------
set test "OMF alignment 6: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/alignment_6.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF alignment 6: alignment power is 2**4 (paragraph)"
if { [regexp "_TEXT.*2\\*\\*4" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  alignment_7.o — SEGDEF with alignment=7 → byte-aligned fallback
# -----------------------------------------------------------------------
set test "OMF alignment 7: format detection (no rejection)"
set got [binutils_run $OBJDUMP "-x tmpdir/alignment_7.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF alignment 7: alignment power is 2**0 (byte)"
if { [regexp "_TEXT.*2\\*\\*0" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  zero_indices.o — SEGDEF with name/class/overlay all zero
# -----------------------------------------------------------------------
set test "OMF zero indices: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/zero_indices.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF zero indices: default name 'UNNAMED'"
if { [regexp {UNNAMED} $got] } {
    pass $test
} else {
    fail $test
}

