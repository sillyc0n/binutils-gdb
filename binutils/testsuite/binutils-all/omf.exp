set test "OMF relocs thread redefine: redef_target relocation"
if { [regexp "redef_target" $got] } {
    pass $test
} else {
    fail $test
}

# Two FIXUP subrecords should produce four reloc lines (target + WRTSEG
# marker for each), confirming the redefinition was consumed rather than
# accumulated onto a stale slot.
set test "OMF relocs thread redefine: reloc count"
set reloc_lines [regexp -all -inline -line {^[0-9a-fA-F]+\s+[A-Z0-9]+\s+\S+$} $got]
if { [llength $reloc_lines] == 4 } {
    pass $test
} else {
    fail "$test (got [llength $reloc_lines] lines)"
}

