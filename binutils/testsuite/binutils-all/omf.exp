# Test that the i386 OMF (Object Module Format) BFD backend correctly
# parses sections, symbols, and relocations from OMF object files.
#
# Test objects are generated by gentestomf.c (binutils/testsuite/gentestomf.c)
# which is compiled to $(build)/binutils/testsuite/gentestomf.
#
# To run just these tests:
#   make check-binutils RUNTESTFLAGS="omf.exp"
#
# Requires gentestomf built first:
#   cd $(build) && make all-binutils

if ![is_remote host] {
    if {[which $OBJDUMP] == 0} then {
	perror "$OBJDUMP does not exist"
	return
    }
}

# Locate the gentestomf test helper.
global base_dir
set gentestomf "$base_dir/testsuite/gentestomf"
if ![file exists $gentestomf] {
    untested "OMF tests (gentestomf not built)"
    return
}

# Generate test objects in tmpdir.
set got [binutils_run $gentestomf "tmpdir"]
if { [regexp "done" $got] } {
    pass "OMF test object generation"
} else {
    fail "OMF test object generation"
    return
}

# -----------------------------------------------------------------------
#  basic.o — minimal valid OMF object
# -----------------------------------------------------------------------
set test "OMF basic: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/basic.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF basic: section _TEXT"
if { [regexp "_TEXT.*00000010.*CONTENTS, ALLOC, LOAD" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  modend_startaddr.o — MODEND with Start Address subfield
# -----------------------------------------------------------------------
set test "OMF modend startaddr: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/modend_startaddr.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF modend startaddr: start address field"
if { [regexp "start address" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  section_offsets.o — multiple LEDATA records at non-zero offsets
# -----------------------------------------------------------------------
set test "OMF sections: size from multiple LEDATA"
set got [binutils_run $OBJDUMP "-x tmpdir/section_offsets.o"]
if { [regexp "_TEXT.*00000040" $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  symbols.o — EXTDEF and PUBDEF symbols
# -----------------------------------------------------------------------
set test "OMF symbols: PUBDEF"
set got [binutils_run $OBJDUMP "-x tmpdir/symbols.o"]
if { [regexp "public_var" $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF symbols: EXTDEF"
if { [regexp "external_func" $got] } {
    pass $test
} else {
    fail $test
}

