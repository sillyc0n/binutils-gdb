# -----------------------------------------------------------------------
#  fixups_diffsegment.o — F0/T0 frame and target in different segments
# -----------------------------------------------------------------------
set test "OMF relocs diffsegment: format detection"
set got [binutils_run $OBJDUMP "-x tmpdir/fixups_diffsegment.o"]
if { [regexp "file format i386omf" $got] } {
    pass $test
} else {
    fail $test
}

# The frame (_TEXT) and target (_DATA) segments differ, so the
# same-segment collapse must NOT fire: expect a WRTSEG marker naming
# _TEXT and a real (non-absolute) target relocation into _DATA.
set test "OMF relocs diffsegment: WRTSEG _TEXT retained"
if { [regexp {WRTSEG.*_TEXT} $got] } {
    pass $test
} else {
    fail $test
}

set test "OMF relocs diffsegment: target not collapsed to *ABS*"
if { ![regexp {\*ABS\*} $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  fixups_simple.o (same-segment case) — confirm the collapse DOES fire
#  when frame and target name the same segment (F0/T0, frame==target).
# -----------------------------------------------------------------------
set test "OMF relocs simple: same-segment collapses to *ABS*"
set got [binutils_run $OBJDUMP "-r tmpdir/fixups_simple.o"]
if { [regexp {\*ABS\*} $got] } {
    pass $test
} else {
    fail $test
}

# -----------------------------------------------------------------------
#  Additional FIXUPP error cases — all must be rejected with
#  "file format not recognized"
# -----------------------------------------------------------------------
foreach errfile {error_undefined_frame_segdef error_undefined_frame_grpdef \
		  error_undefined_frame_extdef error_frame_f6_invalid \
		  error_target_phantom_segdef error_target_phantom_grpdef \
		  error_target_phantom_extdef error_reserved_location \
		  error_truncated_displacement error_frame_thread_masked \
		  error_target_thread_undefined} {
    set test "OMF error: $errfile"
    set got [binutils_run $OBJDUMP "-x tmpdir/$errfile.o"]
    if { [regexp "file format not recognized" $got] } {
	pass $test
    } else {
	fail $test
    }
}

